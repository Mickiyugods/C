# Copy to .env and fill in. Never commit .env.

# Node the keeper reads and writes through. Use a private provider URL (Alchemy etc.), not the public RPC.
RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
CHAIN_ID=4663

# The wallet whose address you passed as KEEPER when deploying (it is the CollectionRegistry keeper).
# It only needs a little ETH for gas. It can post price caps and giveaway snapshots, and cannot move funds.
# Leave empty to run read only.
KEEPER_PRIVATE_KEY=

# From contracts/deployments/<chain>-<tag>.json
LAUNCHER=
REGISTRY=
DISTRIBUTOR=
# Block the Launcher was deployed in, so scans start there.
DEPLOY_BLOCK=0

# Needed for price caps and buying NFTs (OpenSea is where listings are found). Without it only harvest, exits
# and giveaways run.
OPENSEA_API_KEY=
OPENSEA_CHAIN=robinhood

# Tuning (defaults shown)
# CAP_MARGIN_BPS=1500
# MIN_HARVEST_WEI=500000000000000
# CAP_REFRESH_SECONDS=43200
# MAX_BUYS_PER_TICK=3
# INTERVAL_MS=60000
